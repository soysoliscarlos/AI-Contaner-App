# Copy to .env and set values. For Container Apps, these are set by Terraform / portal.
# Use AZURE_OPENAI_TYPE=azure_ad and AZURE_CLIENT_ID=<workload_identity_client_id> for Managed Identity.

# Azure OpenAI (from terraform output: openai_endpoint, openai_deployment_names)
AZURE_OPENAI_BASE=https://<name>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_ADA_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_MODEL=gpt-4o
AZURE_OPENAI_VERSION=2024-02-15-preview
AZURE_OPENAI_TYPE=azure_ad
AZURE_OPENAI_SYSTEM_MESSAGE=You are a helpful assistant.

# Managed Identity (from terraform output: workload_identity_client_id)
AZURE_CLIENT_ID=

# Optional: API key only if not using Managed Identity (AZURE_OPENAI_TYPE=azure)
# AZURE_OPENAI_KEY=

TEMPERATURE=0.9
MAX_RETRIES=5
TIMEOUT=30
CHAINLIT_MAX_FILES=10
CHAINLIT_MAX_SIZE_MB=100
TEXT_SPLITTER_CHUNK_SIZE=1000
TEXT_SPLITTER_CHUNK_OVERLAP=10
EMBEDDINGS_CHUNK_SIZE=16
